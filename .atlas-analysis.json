  "keyFeatures": [
    "Event-driven state management with immutable eventlog",
    "Reactive SQLite database with synchronous in-memory queries",
    "Built-in sync engine with push/pull model (similar to Git)",
    "Offline-first support with automatic conflict resolution",
    "Fine-grained reactivity system with signals, computed values, and SQL queries",
    "Cross-platform adapters (web, Expo/React Native, Node.js, Cloudflare Workers)",
    "Framework integrations for React, Vue, Solid, and Svelte",
    "Multiple sync providers (Cloudflare Durable Objects, ElectricSQL, S2)",
    "DevTools with real-time data browser, eventlog inspector, and query inspector",
    "TypeScript-first with full type safety via Effect Schema"
  ],
  "publicApiSurface": [
    "createStore(options: CreateStoreOptions) => Store",
    "createStorePromise(options: CreateStoreOptionsPromise) => Promise<Store>",
    "StoreRegistry / storeOptions",
    "makeStoreContext() — Effect layer integration",
    "queryDb(query, schema) => LiveQueryDef",
    "signal(initialValue, options?) => SignalDef",
    "computed(fn, options?) => LiveQueryDef",
    "sql template tag — tagged SQL query builder",
    "useQuery(queryDef) — React hook",
    "useStore() — React hook",
    "useSyncStatus() — React hook",
    "useClientDocument() — React hook",
    "Store.commit(event) — commit an event",
    "Store.query(queryDef) — query data imperatively",
    "Store.subscribe(queryDef, callback) — subscribe to reactive state",
    "makeSchemaTable() / Events.synced() / Events.clientOnly()",
    "Schema (re-exported from Effect) for event/state schema definitions",
    "@livestore/adapter-web — makeWebWorkerAdapter()",
    "@livestore/adapter-node — makeNodeAdapter()",
    "@livestore/adapter-expo — makeExpoAdapter()",
    "@livestore/sync-cf — makeSyncBackend() / makeSyncProvider()",
    "@livestore/cli — LiveStore CLI tool"
  ]
}
